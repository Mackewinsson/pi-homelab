# Copy to .env on the Pi (gitignored). Used by install.sh and config generation.

# Name for the locally-managed tunnel (cloudflared tunnel create <name>)
TUNNEL_NAME=pi-audiobookshelf

# Public hostname on a zone in your Cloudflare account (no https:// prefix)
TUNNEL_HOSTNAME=audiobooks.mackewinsson.com

# Local service Audiobookshelf listens on (default stack port)
LOCAL_SERVICE_URL=http://127.0.0.1:13378
